# S.T.A.L.K.E.R. Anomaly Environment Configuration Template
# Copy this file to config/app.env to customize before running scripts/create-app-bundle.sh

# 1: Enable Metal Performance HUD (FPS, Frame Interval, GPU Timing)
# 0: Disable Metal Performance HUD
ENABLE_MTL_HUD=1

# 1: Enable Darwin Mach Semaphore multi-thread synchronization
# 0: Fallback to wineserver socket synchronization
ENABLE_MSYNC=1

# 1: Advertise AVX instructions under Rosetta 2
ROSETTA_ADVERTISE_AVX=1

# Silence console I/O to eliminate terminal stream lock contention (-all or fixme-all)
WINEDEBUG="-all"

# Default game parameters passed to AnomalyDX11AVX.exe
GAME_ARGS="-dbg"

# Target Wine prefix directory
TARGET_PREFIX="$HOME/Library/Application Support/gamma-test-prefix"
